<?php

/**
 * @file
 * Install/update hooks for Open Y Activity Finder Solr.
 */

/**
 * Implements hook_install().
 *
 * A fresh install starts at the highest update number, so update_8001 never
 * runs for it; add the fields here as well.
 */
function openy_activity_finder_solr_install() {
  _openy_activity_finder_solr_add_category_tags_index_fields();
}

/**
 * Indexes the session Category Tags field (id facet and title search).
 */
function openy_activity_finder_solr_update_8001() {
  _openy_activity_finder_solr_add_category_tags_index_fields();
}
